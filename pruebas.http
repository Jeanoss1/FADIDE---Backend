### ===================================================================
### 5. Pruebas del modulo Contratos (Contrato y Pago)
### Requiere haber ejecutado antes los bloques 1 y 2 (tokenAdmin y tokenSupervisor).
### El bloque crea su propio cliente y proyecto para no depender de IDs fijos.
### ===================================================================

### 5.0 Crear un cliente para el proyecto del contrato
POST {{baseUrl}}/api/clientes
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "razonSocial": "Cliente Contratos S.A.C.",
  "ruc": "20{{$random.integer(100000000, 999999999)}}",
  "direccion": "Av. Javier Prado 500, Lima",
  "telefono": "987111222"
}

> {%
    client.global.set("idClienteContrato", response.body.idCliente);
    client.test("Cliente para contratos creado (201)", function() {
        client.assert(response.status === 201, "Se esperaba 201");
    });
%}

### 5.1 Crear un proyecto para asociar los contratos
POST {{baseUrl}}/api/proyectos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "nombre": "Edificio Multifamiliar Los Olivos",
  "ubicacion": "Los Olivos, Lima",
  "idCliente": {{idClienteContrato}}
}

> {%
    client.global.set("idProyectoContrato", response.body.idProyecto);
    client.test("Proyecto para contratos creado (201)", function() {
        client.assert(response.status === 201, "Se esperaba 201");
        client.assert(response.body.idProyecto, "Debe devolver el idProyecto");
    });
%}

### 5.2 Crear contrato valido (monto total 100000; si no se envia estado queda VIGENTE)
POST {{baseUrl}}/api/contratos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "numeroContrato": "CT-{{$random.integer(100000, 999999)}}",
  "fechaInicio": "2026-01-15",
  "fechaFin": "2026-12-15",
  "montoTotal": 100000.00,
  "idProyecto": {{idProyectoContrato}}
}

> {%
    client.global.set("idContrato", response.body.idContrato);
    client.global.set("numeroContrato", response.body.numeroContrato);
    client.test("Crear contrato devuelve 201 con estado VIGENTE", function() {
        client.assert(response.status === 201, "Se esperaba 201");
        client.assert(response.body.idContrato, "Debe devolver el idContrato");
        client.assert(response.body.estado === "VIGENTE", "El estado por defecto debe ser VIGENTE");
    });
%}

### 5.3 Crear contrato con fecha de fin anterior a la de inicio (debe devolver 400)
POST {{baseUrl}}/api/contratos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "numeroContrato": "CT-{{$random.integer(100000, 999999)}}",
  "fechaInicio": "2026-12-15",
  "fechaFin": "2026-01-15",
  "montoTotal": 50000.00,
  "idProyecto": {{idProyectoContrato}}
}

> {%
    client.test("Fechas invertidas devuelven 400", function() {
        client.assert(response.status === 400, "Se esperaba 400");
    });
%}

### 5.4 Crear contrato con un proyecto inexistente (debe devolver 404)
POST {{baseUrl}}/api/contratos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "numeroContrato": "CT-{{$random.integer(100000, 999999)}}",
  "fechaInicio": "2026-01-15",
  "fechaFin": "2026-12-15",
