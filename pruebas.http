### ===================================================================
### 5 (continuacion). Pruebas de Pago
### Requiere haber ejecutado antes las pruebas 5.0 a 5.8 (idContrato con monto total 100000).
### ===================================================================

### 5.11 Registrar un pago de 60000 sobre el contrato (debe devolver 201, estado REGISTRADO)
POST {{baseUrl}}/api/pagos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "monto": 60000.00,
  "fechaPago": "2026-03-01",
  "idContrato": {{idContrato}}
}

> {%
    client.global.set("idPago", response.body.idPago);
    client.test("Crear pago devuelve 201 con valores por defecto", function() {
        client.assert(response.status === 201, "Se esperaba 201");
        client.assert(response.body.idPago, "Debe devolver el idPago");
        client.assert(response.body.estado === "REGISTRADO", "El estado por defecto debe ser REGISTRADO");
        client.assert(response.body.conformidadEmitida === false, "conformidadEmitida por defecto debe ser false");
    });
%}

### 5.12 Registrar un pago que excede el monto del contrato (60000 + 50000 > 100000, debe devolver 409)
POST {{baseUrl}}/api/pagos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "monto": 50000.00,
  "fechaPago": "2026-04-01",
  "idContrato": {{idContrato}}
}

> {%
    client.test("Pago que excede el monto total devuelve 409", function() {
        client.assert(response.status === 409, "Se esperaba 409 (conflicto)");
    });
%}

### 5.13 Registrar un pago que completa exactamente el monto del contrato (60000 + 40000 = 100000, debe devolver 201)
POST {{baseUrl}}/api/pagos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "monto": 40000.00,
  "fechaPago": "2026-05-01",
  "estado": "PAGADO",
  "conformidadEmitida": true,
  "idContrato": {{idContrato}}
}

> {%
    client.test("Pago que llega justo al monto total se acepta (201)", function() {
        client.assert(response.status === 201, "Se esperaba 201");
        client.assert(response.body.estado === "PAGADO", "Debe respetar el estado enviado");
    });
%}

### 5.14 Registrar un pago sobre un contrato inexistente (debe devolver 404)
POST {{baseUrl}}/api/pagos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "monto": 1000.00,
  "fechaPago": "2026-03-01",
  "idContrato": 999999999
}

