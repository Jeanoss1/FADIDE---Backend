# Copiar como .env (en esta misma carpeta) y reemplazar los valores CAMBIAR_...
# preparar.ps1 lo genera automáticamente con claves aleatorias si .env no existe.
# El archivo .env NO se sube a GitHub.

DB_USERNAME=sisco
DB_PASSWORD=CAMBIAR_password_de_la_bd

# Clave de al menos 32 caracteres para firmar los JWT
JWT_SECRET=CAMBIAR_clave_secreta_de_32_o_mas_caracteres

# Administrador inicial que crea DataSeeder
ADMIN_CORREO=admin@fadide.com
ADMIN_PASSWORD=CAMBIAR_password_del_admin

# true = cargar datos-demo.sql en el primer arranque (es idempotente)
CARGAR_DATOS_DEMO=true
